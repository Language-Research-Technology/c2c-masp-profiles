{
  "rootDataset": {
    "type": [
      "Dataset"
    ]
  },
  "metadataLicence": {
    "@id": "https://creativecommons.org/licenses/by/4.0/",
    "@type": "ldac:DataReuseLicense",
    "name": "Attribution 4.0 International (CC BY 4.0)",
    "description": "You are free to: Share — copy and redistribute the material in any medium or format. Adapt — remix, transform, and build upon the material for any purpose, even commercially. This license is acceptable for Free Cultural Works. The licensor cannot revoke these freedoms as long as you follow the license terms.",
    "metadataIsPublic": true,
    "allowTextIndex": true
  },
  "propertyGroups": [
    {
      "name": "About",
      "inputs": [
        "name",
        "description",
        "datePublished",
        "license"
      ]
    },
    {
      "name": "People",
      "inputs": [
        "creator"
      ]
    },
    {
      "name": "Structure",
      "inputs": [
        "hasPart",
        "isPartOf",
        "position"
      ]
    },
    {
      "name": "Content",
      "inputs": [
        "text"
      ]
    },
    {
      "name": "Media",
      "inputs": [
        "image",
        "audio",
        "caption",
        "creditText",
        "custom:imageReference"
      ]
    },
    {
      "name": "Files",
      "inputs": [
        "encodingFormat"
      ]
    }
  ],
  "longTextInputs": ["description", "text"],
  "tools": {
    "chaos2crate": {
      "url": "",
      "version": "0.0.1",
      "buildOptions": {
        "inputMode": "docx",
        "templateRepoFolder": "structured-docs",
        "plugins": [
          { "name": "makeHtml", "enabled": false, "enabledOptions": ["makeHtml", "templateRepoFolder", "homePageId", "domain", "collectionLabelsBuilder", "styledPreview", "configFile"] }
        ]
      }
    }
  }
}