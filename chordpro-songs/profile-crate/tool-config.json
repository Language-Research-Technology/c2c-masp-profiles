{
  "metadata": {
    "name": "ChordPro Songs & Setlists Profile",
    "description": "A minimal RO-Crate profile for songbooks harvested from ChordPro song charts and Markdown setlists \u2014 chaos2crate's chordpro-input plugin.",
    "version": "0.1.0",
    "author": "Peter Sefton",
    "license": "GPL-3.0"
  },
  "rootDataset": {
    "type": [
      "Dataset"
    ],
    "conformsTo": "https://language-research-technology.github.io/c2c-masp-profiles/chordpro-songs/profile-crate/#profile"
  },
  "propertyGroups": [
    {
      "name": "About",
      "help": "The core metadata for this songbook.",
      "inputs": [
        "@id",
        "@type",
        "http://purl.org/dc/terms/conformsTo",
        "http://schema.org/name",
        "http://schema.org/description",
        "http://schema.org/conformsTo",
        "http://schema.org/datePublished",
        "http://schema.org/license"
      ]
    },
    {
      "name": "Songs & Setlists",
      "help": "Properties chordpro-input writes on song, setlist, set, and setlist-entry entities \u2014 see the plugin's own SPEC.md \u00a75\u2013\u00a77.",
      "inputs": [
        "http://schema.org/hasPart",
        "http://schema.org/text",
        "http://schema.org/musicalKey",
        "http://schema.org/composer",
        "http://schema.org/performer",
        "http://schema.org/subtitle",
        "http://www.w3.org/ns/prov#specializationOf"
      ]
    }
  ],
  "lookup": {},
  "enabledClasses": [],
  "tools": {
    "chaos2crate": {
      "url": "",
      "version": "0.0.1",
      "buildOptions": {
        "enabledOptionKeys": [
          "makeHtml",
          "fixStDirective",
          "reviewSetlistMatches",
          "reviewKeyGuesses"
        ],
        "inputMode": "chordpro",
        "makeHtml": true
      }
    }
  }
}
