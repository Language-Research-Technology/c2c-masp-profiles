{
  "name": "c2c-masp-profiles",
  "version": "1.0.0",
  "description": "[MASP](https://github.com/Language-Research-Technology/ro-crate-masp) (Machine Actionable Schema/Profile) crates used by [chaos2crate](https://github.com/Language-Research-Technology/chaos2crate) to drive its folder → RO-Crate build workflow: the profile you pick determines which fields the Describe step asks for and which Build options are shown, and the finished crate is checked against it with `MaspValidator.validateCrate()`.",
  "homepage": "https://github.com/Language-Research-Technology/c2c-masp-profiles#readme",
  "bugs": {
    "url": "https://github.com/Language-Research-Technology/c2c-masp-profiles/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Language-Research-Technology/c2c-masp-profiles.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "validate:birds": "node validate-profile.js birds/profile-crate/examples/birds-crate/ro-crate-metadata.json birds/profile-crate/ro-crate-metadata.json",
    "validate:birds:json": "node validate-profile.js --json birds/profile-crate/examples/birds-crate/ro-crate-metadata.json birds/profile-crate/ro-crate-metadata.json",
    "validate:chordpro-songs": "node validate-profile.js chordpro-songs/profile-crate/examples/chordpro-crate/ro-crate-metadata.json chordpro-songs/profile-crate/ro-crate-metadata.json",
    "validate:chordpro-songs:json": "node validate-profile.js --json chordpro-songs/profile-crate/examples/chordpro-crate/ro-crate-metadata.json chordpro-songs/profile-crate/ro-crate-metadata.json",
    "validate:chordpro-songs-large": "node validate-profile.js chordpro-songs/profile-crate/examples/chordpro-crate-large/ro-crate-metadata.json chordpro-songs/profile-crate/ro-crate-metadata.json",
    "validate:chordpro-songs-large:json": "node validate-profile.js --json chordpro-songs/profile-crate/examples/chordpro-crate-large/ro-crate-metadata.json chordpro-songs/profile-crate/ro-crate-metadata.json"
  },
  "dependencies": {
    "ro-crate-maps": "github:Language-Research-Technology/ro-crate-masp"
  }
}
