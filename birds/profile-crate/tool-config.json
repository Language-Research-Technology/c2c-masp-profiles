{
  "rootDataset": {
    "type": [
      "Dataset",
      "RepositoryCollection"
    ],
    "conformsTo": "https://language-research-technology.github.io/c2c-masp-profiles/birds/profile-crate/#profile"
  },
  "propertyGroups": [
    {
      "name": "About",
      "inputs": [
        "name",
        "description",
        "datePublished",
        "license",
        "conformsTo"
      ]
    },
    {
      "name": "Language",
      "inputs": [
        "inLanguage",
        "ldac:subjectLanguage"
      ]
    },
    {
      "name": "Rights",
      "inputs": [
        "author",
        "publisher",
        "ldac:metadataIsPublic"
      ]
    },
    {
      "name": "Entry",
      "inputs": [
        "custom:translation",
        "custom:scientificName",
        "custom:sentence",
        "custom:sentenceTranslation"
      ]
    },
    {
      "name": "People",
      "inputs": [
        "ldac:speaker",
        "custom:photographerName"
      ]
    },
    {
      "name": "Media",
      "inputs": [
        "image",
        "custom:callAudio",
        "custom:nameAudio",
        "custom:sentenceAudio"
      ]
    },
    {
      "name": "Structure",
      "inputs": [
        "pcdm:hasMember",
        "pcdm:memberOf",
        "isPartOf",
        "about",
        "encodingFormat"
      ]
    }
  ],
  "longTextInputs": [
    "description",
    "custom:sentence",
    "custom:sentenceTranslation"
  ],
  "tools": {
    "chaos2crate": {
      "url": "",
      "version": "0.0.1",
      "buildOptions": {
        "inputMode": "generic",
        "templateRepoFolder": "birds",
        "plugins": [
          { "name": "xlsxCrate", "enabled": true, "enabledOptions": ["xlsxCrate", "xlsxCrateFile"] },
          { "name": "makeHtml", "enabled": false, "enabledOptions": ["makeHtml", "styledPreview", "templateRepoFolder", "configFile"] }
        ]
      }
    }
  }
}
