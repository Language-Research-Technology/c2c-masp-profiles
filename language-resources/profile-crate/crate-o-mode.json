{
  "rootDataset": {
    "type": [
      "Dataset",
      "RepositoryCollection"
    ]
  },
  "propertyGroups": [
    {
      "name": "About",
      "inputs": [
        "name",
        "description",
        "datePublished",
        "license"
      ]
    },
    {
      "name": "Language",
      "inputs": [
        "inLanguage",
        "ldac:austlangCode",
        "ldac:iso639-3"
      ]
    },
    {
      "name": "People",
      "inputs": [
        "creator",
        "author",
        "publisher",
        "ldac:compiler",
        "custom:participant",
        "custom:compiler",
        "custom:contentPerson"
      ]
    },
    {
      "name": "Portal",
      "inputs": [
        "custom:portalName",
        "custom:portalDescription"
      ]
    },
    {
      "name": "Structure",
      "inputs": [
        "hasPart",
        "isPartOf",
        "pcdm:memberOf",
        "pcdm:hasMember",
        "conformsTo",
        "custom:possibleDuplicate"
      ]
    },
    {
      "name": "Files",
      "inputs": [
        "encodingFormat",
        "contentLocation",
        "comment",
        "dateCreated",
        "custom:dateCaptured",
        "numberOfPages",
        "custom:pageRange",
        "ldac:doi",
        "url",
        "ldac:subjectLanguage",
        "ldac:hasDerivation",
        "ldac:derivationOf",
        "ldac:materialType"
      ]
    },
    {
      "name": "Location",
      "inputs": [
        "geo",
        "asWKT"
      ]
    }
  ],
  "longTextInputs": ["description", "custom:portalDescription"],
  "buildOptions": {
    "inputMode": "generic",
    "enableLanguageLookups": true,
    "merge": true,
    "templateRepoFolder": "dyirbal",
    "enabledOptionKeys": [
      "makeHtml", "templateRepoFolder", "styledPreview", "configFile",
      "enableLanguageLookups", "includeAlternateNames",
      "merge", "mergeFile", "mergeMappingBuilder", "doPlaceLookups"
    ]
  }
}